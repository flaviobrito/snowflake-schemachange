# Copy to .env and fill in. Loaded by `make` targets; never commit .env.
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=SVC_ECOMMERCE_CICD
SNOWFLAKE_ROLE=ECOMMERCE_DEPLOYER
SNOWFLAKE_WAREHOUSE=ECOMMERCE_WH
SNOWFLAKE_DATABASE=ECOMMERCE_DEV
SNOWFLAKE_AUTHENTICATOR=snowflake_jwt
SNOWFLAKE_PRIVATE_KEY_FILE=keys/snowflake_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_FILE_PWD=

# dbt
DBT_TARGET=dev
DBT_SNOWFLAKE_ROLE=ECOMMERCE_TRANSFORMER
DBT_PROFILES_DIR=dbt
DBT_PROJECT_DIR=dbt

# Set to false on Snowflake Standard edition (no Data Metric Functions).
ENABLE_DATA_METRIC_FUNCTIONS=true

# Optional: Slack or Teams incoming webhook for schema drift alerts.
SCHEMA_ALERT_WEBHOOK_URL=
